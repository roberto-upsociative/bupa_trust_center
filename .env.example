# Defina no ambiente do servidor a chave PRIVADA correspondente à chave
# pública cadastrada na OneTrust. Nunca use a chave pública neste campo.
# Para variável com quebras de linha, use \n entre as linhas PEM.
ONETRUST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PORT=3000
