# Define en el entorno del servidor la clave PRIVADA que corresponde a la clave
# pública registrada en OneTrust. Nunca uses la clave pública en este campo.
# Para representar saltos de línea, usa \n entre las líneas PEM.
ONETRUST_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PORT=3000
